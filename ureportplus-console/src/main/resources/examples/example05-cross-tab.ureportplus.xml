<?xml version="1.0" encoding="UTF-8"?>
<ureportplus>
  <!-- 交叉表: 酒店 × 房型的营收矩阵 -->
  <cell expand="None" name="A1" row="1" col="1">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><simple-value><![CDATA[酒店营收交叉表]]></simple-value>
  </cell>
  <cell expand="None" name="A2" row="2" col="1">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><simple-value><![CDATA[酒店\房型]]></simple-value>
  </cell>
  <!-- 酒店名称向下展开 -->
  <cell expand="Down" name="A3" row="3" col="1">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><dataset-value aggregate="group" dataset-name="ds1" property="hotel_name" order="none"/>
  </cell>
  <!-- 房型向右展开 -->
  <cell expand="Right" name="B2" row="2" col="2">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><dataset-value aggregate="group" dataset-name="ds1" property="room_type" order="none"/>
  </cell>
  <!-- 交叉单元格: 营收聚合 -->
  <cell expand="None" name="B3" row="3" col="2" left-cell="A3" top-cell="B2">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><dataset-value aggregate="sum" dataset-name="ds1" property="revenue" order="none"/>
  </cell>
  <!-- 行合计 -->
  <cell expand="None" name="B4" row="4" col="2" left-cell="A3">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><dataset-value aggregate="sum" dataset-name="ds1" property="revenue" order="none"/>
  </cell>
  <cell expand="None" name="A4" row="4" col="1">
    <cell-style><left-border width="1" style="solid" color="0,0,0"/><right-border width="1" style="solid" color="0,0,0"/><top-border width="1" style="solid" color="0,0,0"/><bottom-border width="1" style="solid" color="0,0,0"/></cell-style><simple-value><![CDATA[合计]]></simple-value>
  </cell>
  <row row-number="1" height="30"/>
  <row row-number="2" height="25"/>
  <row row-number="3" height="22"/>
  <row row-number="4" height="22" band="summary"/>
  <column col-number="1" width="130"/><column col-number="2" width="100"/>
  <paper type="A4" left-margin="28" right-margin="28" top-margin="28" bottom-margin="28"
    paging-mode="fitpage" fixrows="0" width="595" height="842" orientation="landscape"
    html-report-align="left" bg-image="" html-interval-refresh-value="0"
    column-enabled="false" column-count="2" column-margin="5" auth-enabled="false"/>
  <datasource name="ds1" type="jdbc" driver="org.h2.Driver"
    url="jdbc:h2:mem:ureportplus_demo;DB_CLOSE_DELAY=-1;MODE=MySQL" username="sa" password="">
    <dataset name="ds1" type="sql">
      <sql><![CDATA[select hotel_name, room_type, revenue from hotel_revenue order by hotel_name, room_type]]></sql>
      <field name="hotel_name"/><field name="room_type"/><field name="revenue"/>
    </dataset>
  </datasource>
</ureportplus>