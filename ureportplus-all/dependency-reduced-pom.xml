<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.kingint.ureportplus</groupId>
  <artifactId>ureportplus-all</artifactId>
  <name>UReportPlus All-in-One</name>
  <version>1.0.1</version>
  <description>UReportPlus - High-performance pure Java Chinese-style report engine (All-in-One)</description>
  <url>https://gitee.com/lg10/ureport-plus</url>
  <developers>
    <developer>
      <name>Gaojie</name>
      <email>jacky.gao@kingint.com</email>
      <organization>KinginT</organization>
      <organizationUrl>http://www.kingint.com</organizationUrl>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://gitee.com/lg10/ureport-plus.git</connection>
    <tag>v1.0.0</tag>
    <url>https://gitee.com/lg10/ureport-plus</url>
  </scm>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
